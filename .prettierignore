# Generated by scripts/build-basemap-manifest.mjs on every build. Prettier
# collapses its short arrays, so formatting it would put the checked-in copy
# permanently at odds with whatever the next build writes.
public/basemaps/manifest.json

# Generated by scripts/build-feature-layer-manifest.mjs, same reasoning.
public/feature-layers/manifest.json

# The OSTN15 shift grid, generated by scripts/fetch-ostn15.mjs. Written
# minified on one line deliberately: it is 2,268 pairs of numbers that nobody
# reads, and pretty-printing quadruples a file that ships in the precache.
public/geodesy/

# Build output and vendored binary assets.
dist/
public/fonts/

# The design handoff, kept verbatim as received: inline-styled mockups and a
# generated runtime from the tool that authored them. Reformatting it would
# make it no longer the thing that was handed over.
docs/design/
*.geojson